# HORUSDQ_WORKER_SECRET
# SUPABASE_SERVICE_ROLE_KEY (injected by Supabase)
# RESEND_API_KEY
# RESEND_FROM_EMAIL (verified domain)
# VAPID_PUBLIC_KEY
# VAPID_PRIVATE_KEY
